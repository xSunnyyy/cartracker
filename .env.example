# Required for reliable live prices. Free tier: 8 req/min, 800 req/day.
# Sign up at https://twelvedata.com/dashboard and paste the key here (and
# in your Vercel project's environment variables for deploys).
#
# If unset, the /api/quote route falls back to Yahoo Finance's unauthenticated
# chart endpoint, which Yahoo blocks from most cloud-provider IPs (Vercel/AWS),
# so live prices will not work without this key in production.
TWELVEDATA_API_KEY=
